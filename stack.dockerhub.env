# Portainer stack variables for Docker Hub deployments
# Use with docker-compose-port.yaml
# Example deploy:
# docker compose -f docker-compose-port.yaml --env-file .env --env-file stack.dockerhub.env up -d

# Docker Hub image and fixed release tag
# Format: docker.io/<namespace>/<repo>
MAY_IMAGE=docker.io/garzarobmdocker/may

# Production should use an immutable release tag (avoid latest)
# Example: 1.0.0
MAY_TAG=1.0.0

# Optional staging profile example:
# MAY_TAG=1.0.0-rc1

# Host port for May
MAY_PORT=5050

# Optional container name override (set unique names per environment)
MAY_CONTAINER_NAME=may-prod

# Non-sensitive app settings
UPLOAD_FOLDER=/app/data/uploads

# Security credentials are intentionally kept in .env
# Required in .env: SECRET_KEY, DATABASE_URL, ADMIN_PASSWORD
# Required in .env when using DB profiles:
# POSTGRES_PASSWORD, MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD,
# MARIADB_PASSWORD, MARIADB_ROOT_PASSWORD

# Optional database profile variables (if enabling postgres/mysql/mariadb profile)
POSTGRES_DB=may
POSTGRES_USER=may

MYSQL_DATABASE=may
MYSQL_USER=may

MARIADB_DATABASE=may
MARIADB_USER=may
