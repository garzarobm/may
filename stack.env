# Portainer stack variables
# Use this file with docker-compose-port.yaml when deploying from a GitHub repository.

# Container image from GitHub Container Registry
MAY_IMAGE=ghcr.io/dannymcc/may
MAY_TAG=latest
# CUSTOM_MAY_IMAGE=docker.io/garzarobmdocker/may:latest

# Host port for May
MAY_PORT=5050

# Optional container name override
MAY_CONTAINER_NAME=may

# Non-sensitive app settings
UPLOAD_FOLDER=/app/data/uploads

# Security credentials are intentionally kept in .env
# Required in .env: SECRET_KEY, DATABASE_URL, ADMIN_PASSWORD
# Required in .env when using DB profiles:
# POSTGRES_PASSWORD, MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD,
# MARIADB_PASSWORD, MARIADB_ROOT_PASSWORD

# Optional database profile variables (if enabling postgres/mysql/mariadb profile)
POSTGRES_DB=may
POSTGRES_USER=may

MYSQL_DATABASE=may
MYSQL_USER=may

MARIADB_DATABASE=may
MARIADB_USER=may
