# Portainer stack variables for Docker Hub staging deployments
# Use with docker-compose-port.yaml
# Example deploy:
# docker compose -f docker-compose-port.yaml --env-file .env --env-file stack.dockerhub.staging.env up -d

# Docker Hub image and staging tag
# Format: docker.io/<namespace>/<repo>
MAY_IMAGE=docker.io/garzarobdocker/may

# Staging should use a pre-release/dev tag
# Examples: 1.0.0-rc1, dev, staging-2026-07-08
MAY_TAG=1.0.0-rc1

# Host port for staging
MAY_PORT=5051

# Optional container name override (keep unique per environment)
MAY_CONTAINER_NAME=may-staging

# Non-sensitive app settings
UPLOAD_FOLDER=/app/data/uploads

# Security credentials are intentionally kept in .env
# Required in .env: SECRET_KEY, DATABASE_URL, ADMIN_PASSWORD
# Required in .env when using DB profiles:
# POSTGRES_PASSWORD, MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD,
# MARIADB_PASSWORD, MARIADB_ROOT_PASSWORD

# Optional database profile variables (if enabling postgres/mysql/mariadb profile)
POSTGRES_DB=may
POSTGRES_USER=may

MYSQL_DATABASE=may
MYSQL_USER=may

MARIADB_DATABASE=may
MARIADB_USER=may
